# --- Required: GoHighLevel public API ---
# Create a Private Integration Token in GHL:
#   Settings -> Private Integrations -> Create New
# Give it every scope you want the CLI to use (contacts, workflows, etc).
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your GHL location/sub-account ID (the long string in your GHL URL).
GHL_LOCATION_ID=YOUR_LOCATION_ID

# --- Optional: needed only to create/update workflows (internal API, --experimental) ---
# The public GHL API can't *create* workflows, only read them.
# cli_anything/gohighlevel/utils/ghl_internal_client.py tries these in order:
#
# 1. GHL_BACKEND_BEARER (preferred, currently required by the workflow API):
#    a GHL-native "LeadConnector" bearer token. Capture it from your browser's
#    devtools Network tab on app.gohighlevel.com -> a request to
#    backend.leadconnectorhq.com -> "Copy as cURL" -> pull the
#    "Authorization: Bearer <token>" value out.
GHL_BACKEND_BEARER=
#    (alternative to the env var above: save the raw token to a
#    _ghl_bearer.txt file in the repo root instead)
#
# 2. GHL_FIREBASE_REFRESH_TOKEN (legacy fallback): grabbed by the bundled
#    Chrome extension (load chrome-extension/ unpacked, open an
#    app.gohighlevel.com tab, click the extension icon -> "Grab Refresh
#    Token" -> "Copy to Clipboard"). As of this writing the workflow API
#    rejects the Firebase id-token this produces, so it may not work for
#    workflow creation even though the CLI will accept it as a fallback.
GHL_FIREBASE_REFRESH_TOKEN=
#
# 3. GHL_FIREBASE_TOKEN: a Firebase ID token supplied directly. Same caveat
#    as GHL_FIREBASE_REFRESH_TOKEN above.
GHL_FIREBASE_TOKEN=
